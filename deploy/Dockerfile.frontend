# 前端生产镜像 - 仅打包预构建产物
# 前置条件: 需要先在宿主机执行 npm run build（产物在 prod/frontend/dist/）

FROM nginx:alpine

# 创建非 root 用户运行 nginx
RUN adduser -S nginx-user -u 1001 && \
    chown -R nginx-user /var/cache/nginx && \
    chown -R nginx-user /var/log/nginx && \
    chown -R nginx-user /usr/share/nginx/html && \
    touch /var/run/nginx.pid && \
    chown nginx-user /var/run/nginx.pid

# 复制自定义 nginx 配置
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# 复制预构建的前端产物
COPY --chown=nginx-user prod/frontend/dist /usr/share/nginx/html

USER nginx-user

# 暴露端口（与nginx.conf中的listen端口一致）
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:3000/ || exit 1

# 启动 nginx
CMD ["nginx", "-g", "daemon off;"]
