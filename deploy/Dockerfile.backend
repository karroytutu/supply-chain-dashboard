# 后端生产镜像 - 安装生产依赖 + Playwright 浏览器 + 打包预编译产物
# 前置条件: 需要先在宿主机执行 npm run build（产物在 prod/backend/dist/）

FROM node:20-bookworm-slim

# 基础系统层（极少变动，永久缓存命中）
# 1. 换阿里云镜像源
# 2. 安装 gosu（entrypoint 以 root 修权后降权到 nodejs 使用）
# 3. 创建非 root 用户 nodejs
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends gosu ca-certificates && \
    addgroup --gid 1001 --system nodejs && \
    adduser --uid 1001 --system --ingroup nodejs nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 依赖层（仅在 package.json 变动时失效）
COPY dev/backend/package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Playwright 浏览器层（独立缓存，代码变动不触发重装）
# 仅安装 Chromium（比 Firefox 轻量，约 300MB vs 500MB）
# 使用 /app/.cache 而非 /root/.cache，确保 gosu 降权后 nodejs 用户可访问
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.cache/ms-playwright
RUN npx playwright install-deps chromium && \
    npx playwright install chromium && \
    chown -R nodejs:nodejs /app/.cache

# 代码层（频繁变动，放最后，避免影响上游缓存）
COPY --chown=nodejs:nodejs prod/backend/dist ./dist
COPY --chown=nodejs:nodejs deploy/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh && \
    mkdir -p /app/uploads/ar-evidence /app/uploads/return-evidence /app/uploads/credit-license /app/logs && \
    chown -R nodejs:nodejs /app/uploads /app/logs

ENTRYPOINT ["/app/entrypoint.sh"]

# 注意：不使用 USER 指令，entrypoint 以 root 启动修复权限后通过 gosu 降权到 nodejs

ENV NODE_ENV=production

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:8000/api/health || exit 1

CMD ["node", "dist/app.js"]
