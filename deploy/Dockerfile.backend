# 后端生产镜像 - 安装生产依赖 + Playwright 浏览器 + 打包预编译产物
# 前置条件: 需要先在宿主机执行 npm run build（产物在 prod/backend/dist/）

FROM node:20-bookworm-slim

# 基础系统层（极少变动，永久缓存命中）
# 1. 换阿里云镜像源
# 2. 安装 gosu（entrypoint 以 root 修权后降权到 nodejs 使用）
# 3. 创建非 root 用户 nodejs
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends gosu ca-certificates && \
    addgroup --gid 1001 --system nodejs && \
    adduser --uid 1001 --system --ingroup nodejs nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 依赖层（仅在 package.json 变动时失效）
# 使用 npmmirror 国内镜像加速
# BuildKit 缓存挂载：npm 下载包持久化，层缓存失效时仍可复用已下载的包
COPY dev/backend/package*.json ./
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm config set registry https://registry.npmmirror.com && \
    npm ci --omit=dev

# Playwright 浏览器层（独立缓存，代码变动不触发重装）
# 浏览器从宿主机缓存预置（deploy.sh 自动处理），避免构建时从 CDN 下载（国内慢）
# install-deps 仅安装 Chromium 所需的系统依赖（apt 包），不下载浏览器本身
# 使用 /app/.cache 而非 /root/.cache，确保 gosu 降权后 nodejs 用户可访问
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.cache/ms-playwright
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    npx playwright install-deps chromium

# 从宿主机预置的浏览器缓存中 COPY（由 deploy.sh 自动准备）
# 仅在预置目录为空时才回退到 CDN 下载
COPY deploy/playwright-browsers /tmp/pw-browsers
RUN mkdir -p /app/.cache/ms-playwright && \
    if ls /tmp/pw-browsers/chromium-* 1>/dev/null 2>&1; then \
        cp -r /tmp/pw-browsers/* /app/.cache/ms-playwright/; \
        echo "Playwright 浏览器已从宿主机缓存预置（跳过 CDN 下载）"; \
    else \
        echo "[WARN] 未找到预置浏览器，回退到 CDN 下载..."; \
        unset PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD; \
        npx playwright install chromium; \
    fi && \
    rm -rf /tmp/pw-browsers && \
    chown -R nodejs:nodejs /app/.cache

# 代码层（频繁变动，放最后，避免影响上游缓存）
COPY --chown=nodejs:nodejs prod/backend/dist ./dist
# 数据库迁移 SQL 文件（tsc 不复制非 TS 文件，需手动 COPY）
COPY --chown=nodejs:nodejs dev/backend/src/db/migrations ./dist/db/migrations
COPY --chown=nodejs:nodejs deploy/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh && \
    mkdir -p /app/uploads/ar-evidence /app/uploads/return-evidence /app/uploads/credit-license /app/uploads/oa-exports /app/uploads/oa-attachment /app/uploads/oa-statement /app/logs && \
    chown -R nodejs:nodejs /app/uploads /app/logs

ENTRYPOINT ["/app/entrypoint.sh"]

# 注意：不使用 USER 指令，entrypoint 以 root 启动修复权限后通过 gosu 降权到 nodejs

ENV NODE_ENV=production

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:8000/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))" || exit 1

CMD ["node", "dist/app.js"]
