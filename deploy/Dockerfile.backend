# 后端生产镜像 - 安装生产依赖 + 打包预编译产物
# 前置条件: 需要先在宿主机执行 npm run build（产物在 prod/backend/dist/）

FROM node:20-alpine

# 创建非 root 用户运行服务
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

WORKDIR /app

# 安装生产依赖
COPY dev/backend/package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# 复制预编译的后端产物
COPY --chown=nodejs:nodejs prod/backend/dist ./dist

# 创建上传目录和日志目录并设置权限
RUN mkdir -p /app/uploads/ar-evidence /app/uploads/return-evidence /app/logs && \
    chown -R nodejs:nodejs /app/uploads /app/logs

USER nodejs

ENV NODE_ENV=production

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:8000/api/health || exit 1

CMD ["node", "dist/app.js"]
