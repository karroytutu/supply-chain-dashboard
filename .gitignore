# 依赖目录
node_modules/
dev/frontend/node_modules/
dev/backend/node_modules/

# 根目录 package-lock（无依赖项，不需要）
/package-lock.json

# 构建产物
dist/
.umi/
.umi-production/
dev/frontend/dist/
dev/backend/dist/
dev/backend/dingtalk-oapi/

# 生产环境（不提交）
prod/
prod.backup/
backup_*/

# 环境配置（敏感信息）
dev/backend/.env.development
dev/backend/.env.production
prod/backend/.env

# 日志文件
*.log
npm-debug.log*
logs/

# IDE 配置
.idea/
.vscode/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db
__MACOSX/

# 临时文件
*.tmp
*.temp

# Docker 构建缓存 key（自动生成）
deploy/.build-cache-key
deploy/.dockerfile-cache-key

# Playwright 浏览器预置目录（构建前自动生成，构建后自动清理）
deploy/playwright-browsers/

# 测试覆盖率
coverage/

# E2E 测试
playwright-report/
dev/frontend/e2e/.auth/
test-results/

# 上传文件目录
uploads/

# Qoder IDE 自动生成文件
.qoder/

# Trae IDE 自动生成文件
.trae/
