# ========================
# 环境变量配置模板
# ========================
# 使用方法：
#   1. 复制此文件为 .env.development（开发环境）
#   2. 填写实际的配置值
#   3. 生产环境的 .env 文件单独维护在服务器上，不提交到 Git
#
# 带 * 标记的为必需变量，缺失会导致启动失败

# ========================
# 服务端口
# ========================
PORT=8100
NODE_ENV=development

# ========================
# * 应用数据库（PostgreSQL）
# ========================
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=xly_dashboard
APP_DB_USER=postgres
APP_DB_PASSWORD=<your-password>

# ========================
# * 钉钉配置
# ========================
DINGTALK_APP_KEY=<your-dingtalk-app-key>
DINGTALK_APP_SECRET=<your-dingtalk-app-secret>
DINGTALK_CORP_ID=<your-dingtalk-corp-id>
DINGTALK_AGENT_ID=<your-dingtalk-agent-id>

# ========================
# * JWT 配置（生产环境必须使用强密钥，至少32位随机字符）
# 生成命令：openssl rand -base64 32
# ========================
JWT_SECRET=<generate-with-openssl-rand-base64-32>
JWT_EXPIRES_IN=24h

# ========================
# * 应用基础URL
# ========================
# 开发环境：http://localhost:3100
# 生产环境：https://xly.gzzxd.com
APP_BASE_URL=http://localhost:3100

# 钉钉跳转链接基础URL（始终指向生产域名，与运行环境无关）
DINGTALK_BASE_URL=https://xly.gzzxd.com

# ========================
# * CORS 允许的源
# ========================
# 开发环境：http://localhost:3100
# 生产环境：https://xly.gzzxd.com
ALLOWED_ORIGINS=http://localhost:3100

# ========================
# 舟谱云管家 ERP API
# ========================
ERP_API_BASE_URL=https://portal.zhoupudata.com
ERP_API_CID=10008421
ERP_API_UID=1
ERP_API_TIMEOUT=10000
ERP_API_RETRY_MAX=3
ERP_API_RATE_LIMIT_MS=200
ERP_API_MAX_GROUP_CONCURRENCY=4
ERP_API_MAX_GLOBAL_CONCURRENCY=12

# ERP 同步引擎专用（批量拉取超时更长）
ERP_SYNC_TIMEOUT=30000
ERP_SYNC_RETRY_MAX=5

# ========================
# Token 管理（登录凭证）
# ========================
ERP_LOGIN_USERNAME=<your-erp-username>
ERP_LOGIN_PASSWORD=<your-erp-password>
WMS_LOGIN_USERNAME=<your-wms-username>
WMS_LOGIN_PASSWORD=<your-wms-password>
WMS_SSO_BASE_URL=https://sso.zhoupudata.com
B2B_BASE_URL=https://bluespace-plus.zhoupudata.com

# ========================
# 日志
# ========================
# 开发环境建议 debug，生产环境建议 info 或 warn
LOG_LEVEL=debug
